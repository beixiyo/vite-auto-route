{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vite/client"],
    "paths": {
      "@jl-org/vite-auto-route": ["../src/index.ts"],
      "@jl-org/react-router": ["../../react-router/src/router/index.ts"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
